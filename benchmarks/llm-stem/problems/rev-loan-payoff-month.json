  "statement": "A $10,000 debt grows by 1% each month, after which a $500 payment is made. After how many months is the balance zero or negative for the first time?",
  "answer": {
    "var": "m",
    "values": [
      23
    ]
  },
  "reference": {
    "files": {
      "rev-loan-payoff-month.fw": [
        "answer = bal(m)",
        "",
        "[bal(n) -> result]",
        "result = 10000 if n <= 0",
        "result = bal(n-1) * 1.01 - 500 if n > 0"
      ]
    },
    "command": "'rev-loan-payoff-month.fw(m=?min in [1..100], answer<=0)'"
  }
