{
  "id": "pw-tax",
  "category": "piecewise",
  "difficulty": "easy",
  "tags": [],
  "statement": "Income tax is 10% on the first $10,000, 20% on income between $10,000 and $40,000, and 30% on income above $40,000. How much tax is owed on an income of $50,000?",
  "answer": {
    "var": "tax",
    "values": [
      10000
    ]
  },
  "reference": {
    "files": {
      "pw-tax.fw": [
        "tax = 0.1*income iff income <= 10000",
        "tax = 1000 + 0.2*(income - 10000) iff income > 10000 && income <= 40000",
        "tax = 7000 + 0.3*(income - 40000) iff income > 40000"
      ]
    },
    "command": "'pw-tax.fw(tax=?, income=50000)'"
  }
}
