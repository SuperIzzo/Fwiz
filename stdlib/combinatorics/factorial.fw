# factorial.fw — n! via a bounded product.
#
#   factorial(n) = product(i, i in [1..n]) = 1 * 2 * ... * n
#
# factorial(0) = 1 falls out of the empty-product identity ([1..0] is empty,
# product over an empty domain is 1) — no special-case branch needed.
# Exact integer arithmetic; no floating-point intermediate factorials.
#
# Usage:
#   fwiz 'stdlib/combinatorics/factorial.fw(r=?, r=factorial(5))'   # -> r = 120
#   See docs/Stdlib.md §Invocation for the @include consumer form.

[factorial(n) -> result]
result = product(i, i in [1..n])
