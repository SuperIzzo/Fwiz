# falling.fw — falling factorial (Pochhammer descending), written x^(m) underline.
#
#   falling(x, m) = x * (x-1) * (x-2) * ... * (x-m+1)   (m factors)
#
# Equivalently nPr(x, m) for integer x; defined here for any x so it composes
# as a polynomial building block. Product form, overflow-safe.
#
#   product(x-i+1, i in [1..m])
#
# falling(x, 0) = 1 via the empty-product identity.
#
# Usage:
#   fwiz --legacy-implicit 'stdlib/combinatorics/falling.fw(f=?, f=falling(5,2))'   # -> f = 20
#   See docs/Stdlib.md §Invocation for the @include consumer form.

[falling(x, m) -> result]
result = product(x-i+1, i in [1..m])
