# rising.fw — rising factorial (Pochhammer ascending), written x^(m) overline.
#
#   rising(x, m) = x * (x+1) * (x+2) * ... * (x+m-1)     (m factors)
#
# The ascending companion to falling.fw. Product form, overflow-safe.
#
#   product(x+i-1, i in [1..m])
#
# rising(x, 0) = 1 via the empty-product identity.
#
# Usage:
#   fwiz --legacy-implicit 'stdlib/combinatorics/rising.fw(r=?, r=rising(5,2))'   # -> r = 30
#   See docs/Stdlib.md §Invocation for the @include consumer form.

[rising(x, m) -> result]
result = product(x+i-1, i in [1..m])
