# product_of(xs) — product of a seq collection, as a foldl over the mul operator.
# Callable with a seq argument (collections-as-call-arguments, gen-6 cycle 3).
# Coexists with the C++ `product` fast-path and is proven equivalent. Empty
# collection -> 1 (the mul identity / fold seed).
@include "mul.fw"
[product_of(xs) -> result]
result = foldl(xs, mul, 1)
