# count_of(xs) — element count of a seq collection, as a foldl that increments
# the accumulator by 1 per element. Callable with a seq argument (collections-
# as-call-arguments, gen-6 cycle 3). Coexists with the C++ `count` fast-path and
# is proven equivalent. Empty collection -> 0.
@include "count_op.fw"
[count_of(xs) -> result]
result = foldl(xs, count_op, 0)
