# mean_of(xs) — arithmetic mean of a seq collection, composed from sum_of and
# count_of. Callable with a seq argument (collections-as-call-arguments, gen-6
# cycle 3). Coexists with the C++ `mean` fast-path and is proven equivalent.
# Yields an EXACT structural rational (mean_of({1,2,3,4}) -> 5/2), never a float,
# matching the C++ `mean` rational path.
@include "sum_of.fw"
@include "count_of.fw"
[mean_of(xs) -> result]
result = sum_of(xs) / count_of(xs)
