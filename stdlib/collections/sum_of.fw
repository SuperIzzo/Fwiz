# sum_of(xs) — sum of a seq collection, as a foldl over the add operator.
# Callable with a seq argument (collections-as-call-arguments, gen-6 cycle 3).
# Coexists with the C++ `sum` fast-path and is proven equivalent to it (named-
# section equivalence proof in src/tests.cpp). Empty collection -> 0 (the add
# identity / fold seed).
@include "add.fw"
[sum_of(xs) -> result]
result = foldl(xs, add, 0)
